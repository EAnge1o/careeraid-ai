# 复制为 .env 后按需填写（可选，不配置也能以 offline 模式完整运行）

# ===== 大模型 Provider（offline / spark / openai_compatible / volc）=====
AI_PROVIDER=offline

# ---- 讯飞星火 ----
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_API_URL=
SPARK_MODEL=

# ---- OpenAI 兼容接口 ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- 火山引擎（火山方舟/豆包）----
VOLC_BASE_URL=
VOLC_API_KEY=
VOLC_MODEL=
# VOLC_ENABLE_WEB_SEARCH=true

# ===== Web =====
# 生产环境请务必修改
SECRET_KEY=change-me-to-a-random-string

# ===== 用户系统 =====
# 管理员（admin）首次登录时的初始密码；创建后请在后台修改
ADMIN_INIT_PASSWORD=123456
